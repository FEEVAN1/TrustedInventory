# Copy to .env (never committed) and replace every value. Development only; use unique random values.
# Keys are base64 of at least 32 random bytes, e.g. PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))

POSTGRES_PASSWORD=<postgres-superuser-password>
TI_MIGRATOR_PASSWORD=<migrator-password>
TI_APP_PASSWORD=<app-runtime-password>
TI_PLATFORM_PASSWORD=<platform-password>
TI_CONTROL_PASSWORD=<control-plane-password>

TI_CURSOR_KEY=<base64-32-bytes>
TI_CHECKPOINT_KEY=<base64-32-bytes>
TI_LINK_KEY=<base64-32-bytes>
TI_INBOX_KEY=<base64-32-bytes>
# Simulator webhook signing secret (DEC-064): any random string of at least 32 characters. Never a real provider secret.
TI_BILLING_SIM_SECRET=<random-string-at-least-32-chars>
# Paystack test-mode run only (docs/paystack-sandbox.md, DEC-068). Leave both unset to use the simulator. Never a live key.
# TI_BILLING_PROVIDER=paystack
# TI_PAYSTACK_SECRET_KEY=<paystack-test-secret-key-sk_test>

KEYCLOAK_ADMIN_PASSWORD=<keycloak-admin-password>
# Password and TOTP seed shared by the synthetic Keycloak users (alice, quinn, bob, platform-admin).
# The TOTP seed is a plain string; authenticator apps need its base32 encoding.
TI_DEV_USER_PASSWORD=<synthetic-user-password>
TI_DEV_OTP_SECRET=<synthetic-totp-seed-at-least-20-chars>

# Public support contact shown by GET /api/v1/service-status (SOP-006). Optional in development; a placeholder, never a real address here.
# TI_SUPPORT_CONTACT=<support-contact>

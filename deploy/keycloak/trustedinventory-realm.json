                                                                 ]
                                },
                                {
                                    "alias":  "ti direct grant",
                                    "description":  "Development verification only: password plus mandatory OTP",
                                    "providerId":  "basic-flow",
                                    "topLevel":  true,
                                    "builtIn":  false,
                                    "authenticationExecutions":  [
                                                                     {
                                                                         "requirement":  "REQUIRED",
                                                                         "priority":  10,

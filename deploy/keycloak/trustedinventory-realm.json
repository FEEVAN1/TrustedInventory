    "otpPolicyType":  "totp",
    "otpPolicyAlgorithm":  "HmacSHA1",
    "otpPolicyDigits":  6,
    "otpPolicyPeriod":  30,
    "otpPolicyLookAheadWindow":  1,
    "browserFlow":  "ti browser",
    "directGrantFlow":  "ti direct grant",
    "authenticatorConfig":  [
                                {
                                    "alias":  "ti-amr-pwd",
